{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src/pages", "src/features", "src/shared", "src/data", "src/types"],
  "exclude": ["src/features/*/main", "src/features/*/worker", "src/**/*.worker.ts"]
}
